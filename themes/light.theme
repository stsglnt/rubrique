# rubrique built-in theme: Light
# Copy this file to ~/.config/rubrique/themes/ (macOS: ~/Library/Application
# Support/rubrique/themes/) under a new name to make your own theme.
# Colors are #rrggbb. Keys you leave out come from the `base` theme.
name=Light
base=light

# Editor and preview page, text fields, dialogs
background=#fdfcfa
# Explorer, top bar and status bar
sidebar=#f3f2ee
# Buttons and checkboxes
surface=#e8e6e0
# Buttons and rows under the mouse
hover=#dedbd3
# Panel edges, separators, outlines
border=#dcd9d2
text=#2b2a28
# Headings and hovered text
text_strong=#121211
# Hints, quotes, info strings
text_weak=#68655d
# Links, text cursor, focus outline
accent=#2f6fde
# Selected text and the open file in the explorer
selection=#cfe0fb
code_background=#f0eee9
warning=#a86500
error=#c62f2f
